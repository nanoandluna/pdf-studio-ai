{
  "name": "pdf-studio-ai",
  "version": "0.4.1",
  "description": "Local-first PDF desktop workspace with optional AI assistance",
  "author": "nanoandluna",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main && npm run build:licenses",
    "start": "npm run build && node scripts/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --win portable",
    "dist": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check": "npm run check:scripts && npm run typecheck && npm test && npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "build:licenses": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nanoandluna/pdf-studio-ai.git"
  },
  "bugs": {
    "url": "https://github.com/nanoandluna/pdf-studio-ai/issues"
  },
  "homepage": "https://github.com/nanoandluna/pdf-studio-ai#readme",
  "keywords": [
    "pdf",
    "electron",
    "ai",
    "copilot",
    "ocr",
    "desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
