{
  "name": "pdf-studio-ai",
  "version": "0.4.0",
  "description": "PDF Studio AI - Local-First + AI-Native PDF Desktop Application (v0.4.0 RC)",
  "author": "PDF Studio AI",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && node scripts/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --win portable",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-builder": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nanoandluna/pdf-studio-ai.git"
  },
  "bugs": {
    "url": "https://github.com/nanoandluna/pdf-studio-ai/issues"
  },
  "homepage": "https://github.com/nanoandluna/pdf-studio-ai#readme",
  "keywords": [
    "pdf",
    "electron",
    "ai",
    "copilot",
    "ocr",
    "desktop"
  ],
  "engines": {
    "node": ">=18"
  }
}